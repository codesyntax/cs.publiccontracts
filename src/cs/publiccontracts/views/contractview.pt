<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  lang="en"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="cs.publiccontracts"
>
  <body>
    <tal:comment tal:condition="nothing">
      This is a sample view template. It will not be used for rendering the
      content unless activated by creation of a view class with a matching name.
    </tal:comment>

    <metal:main fill-slot="content-core">
      <metal:content-core define-macro="content-core">
        
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
          <h2 class="mb-0 me-3" tal:condition="context/file_number">
            <span class="badge bg-secondary">
              <span i18n:translate="file_number_title">File number:</span>
              <span tal:content="context/file_number"></span>
            </span>
          </h2>

          <div class="d-flex gap-4 mt-2 mt-md-0" tal:define="toLocalizedTime nocall:here/@@plone/toLocalizedTime">
            <div class="d-flex align-items-center" tal:define="published_date context/EffectiveDate" condition="published_date">
              <span class="text-muted text-uppercase small me-2 fw-bold" i18n:translate="published_date">published_date</span>
              <strong tal:content="python:toLocalizedTime(published_date)"></strong>
            </div>

            <div class="d-flex align-items-center px-3 py-2 rounded border border-2 border-primary bg-white shadow-sm" tal:define="has_hour python:context.has_hour(context.last_date);last_date context/last_date" condition="last_date">
              <span class="text-primary text-uppercase small me-2 fw-bold" style="letter-spacing: 0.5px;" i18n:translate="last_date">last_date</span>
              <strong class="fs-5 text-primary" tal:content="python:toLocalizedTime(last_date, long_format=has_hour)"></strong>
            </div>
          </div>
        </div>

        <div class="card mb-4 shadow-sm border-0 bg-light"
             tal:define="file_type_string context/file_type_string;
                       file_procedure_string context/file_procedure_string;
                       file_processing context/file_processing_string;
                       file_body context/file_body_string;
                       file_organization context/file_organization_string;
                       file_state context/file_state_string;
                       info context/info;"
             tal:condition="python:file_type_string or file_procedure_string or file_processing or file_state or info">
          <div class="card-body">
            <h3 class="h5 border-bottom pb-2 mb-3 text-secondary" i18n:translate="contract_information">Contract Information</h3>
            <div class="row">
              <div tal:attributes="class python:'col-md-6' if info else 'col-md-12'">
                <dl class="row mb-0">
                  <tal:define condition="file_type_string">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_type">file_type</dt>
                    <dd class="col-sm-7 mb-2" tal:content="file_type_string"></dd>
                  </tal:define>

                  <tal:define condition="file_procedure_string">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_procedure">file_procedure</dt>
                    <dd class="col-sm-7 mb-2" tal:content="file_procedure_string"></dd>
                  </tal:define>

                  <tal:define condition="file_processing">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_processing">file_processing</dt>
                    <dd class="col-sm-7 mb-2" tal:content="file_processing"></dd>
                  </tal:define>

                  <tal:define condition="file_body">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_body">file_body</dt>
                    <dd class="col-sm-7 mb-2" tal:content="file_body"></dd>
                  </tal:define>

                  <tal:define condition="file_organization">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_organization">file_organization</dt>
                    <dd class="col-sm-7 mb-2" tal:content="file_organization"></dd>
                  </tal:define>

                  <tal:define condition="file_state">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="file_state">file_state</dt>
                    <dd class="col-sm-7 mb-2"><span class="badge bg-info text-dark" tal:content="file_state"></span></dd>
                  </tal:define>
                </dl>
              </div>

              <div class="col-md-6" tal:condition="info">
                <div class="h-100 d-flex flex-column">
                  <h4 class="h6 text-muted text-uppercase mb-2" style="font-size: 0.85em;" i18n:translate="info">info</h4>
                  <div class="p-3 bg-white border rounded flex-grow-1" tal:content="structure context/info/output"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-4" tal:condition="context/dates">
            <div class="card h-100 shadow-sm border-0 bg-light">
              <div class="card-body">
                <h3 class="h5 border-bottom pb-2 mb-3 text-secondary" i18n:translate="dates">Other Dates</h3>
                <dl class="row mb-0">
                  <tal:repeat tal:repeat="date context/dates">
                    <dt class="col-sm-5 text-muted fw-normal text-uppercase mb-2" style="font-size: 0.85em;" tal:content="date/title"></dt>
                    <dd class="col-sm-7 mb-2" tal:define="has_hour python:context.has_hour(date['day'])">
                      <tal:replace tal:replace="python:context.toLocalizedTime(date['day'], long_format=has_hour)"></tal:replace>
                    </dd>
                  </tal:repeat>
                </dl>
              </div>
            </div>
          </div>

          <div class="col-md-6 mb-4" tal:define="files context/files" tal:condition="files">
            <div class="card h-100 shadow-sm border-0 bg-light">
              <div class="card-body">
                <h3 class="h5 border-bottom pb-2 mb-3 text-secondary" i18n:translate="files">Files</h3>
                <div class="list-group">
                  <tal:repeat repeat="file files">
                    <div class="list-group-item list-group-item-action border-0 mb-2 rounded bg-white shadow-sm">
                      <h4 class="h6 mb-2" tal:content="file/Title"></h4>
                      <tal:filecontent tal:define="content_type file/file/contentType|nothing;">
                        <div class="d-flex align-items-center">
                          <a class="text-decoration-none btn btn-outline-primary btn-sm d-inline-flex align-items-center me-3" tal:attributes="href string:${file/absolute_url}/@@download/file/${file/file/filename}">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download me-2" viewBox="0 0 16 16">
                              <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                              <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                            </svg>
                            <tal:name tal:content="file/file/filename">Filename</tal:name>
                          </a>
                          <span class="text-muted small" tal:define="size file/file/getSize; kb python:size/1024">
                            <span tal:replace="python:'{:.2f}'.format(kb)" /> KB
                          </span>
                        </div>

                        <div class="mt-3 bg-light p-3 rounded border" tal:condition="python: content_type and content_type.startswith('text')">
                          <h5 class="h6 text-muted mb-2" i18n:domain="plone" i18n:translate="heading_file_contents">File contents</h5>
                          <pre class="mb-0" style="max-height: 200px; overflow-y: auto;" tal:content="file/file/data|nothing" />
                        </div>
                      </tal:filecontent>
                    </div>
                  </tal:repeat>
                </div>
              </div>
            </div>
          </div>
        </div>
      </metal:content-core>
    </metal:main>
  </body>
</html>