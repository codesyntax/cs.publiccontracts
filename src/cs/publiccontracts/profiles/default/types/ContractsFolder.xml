<?xml version="1.0"?>
<object name="cs.publiccontracts.contractsfolder"
   meta_type="Dexterity FTI"
   i18n:domain="cs.publiccontracts" xmlns:i18n="http://xml.zope.org/namespaces/i18n">

  <!-- Basic metadata -->
  <property name="title" i18n:translate="">ContractsFolder</property>
  <property name="description"
    i18n:translate="">Contracts Folder</property>
  <property name="icon_expr">string:puzzle</property>
  <property name="factory">cs.publiccontracts.contractsfolder</property>
  <property name="global_allow">True</property>
  <property name="filter_content_types">True</property>
  <property name="allow_discussion">False</property>
  <property name="allowed_content_types">
      <element value="Contract" />
  </property>
  <!-- schema and class used for content items -->
  <property name="schema">cs.publiccontracts.contractsfolder.IContractsFolder</property>
  <property name="klass">cs.publiccontracts.contractsfolder.ContractsFolder</property>

  <property name="behaviors">
    <element value="plone.namefromtitle" />
    <element value="plone.dublincore"/>
    <element value="plone.allowdiscussion"/>
    <element value="plone.excludefromnavigation"/>
    <element value="plone.constraintypes"/>
    <element value="plone.relateditems"/>
    <element value="plone.versioning" />
    <element value="plone.tableofcontents"/>
    <element value="plone.nextprevioustoggle"/>
    <element value="plone.translatable" />
   </property>

  <!-- View information -->
  <property name="link_target"></property>
  <property name="immediate_view">view</property>
  <property name="default_view">view</property>
  <property name="view_methods">
   <element value="view"/>
  </property>
  <property name="default_view_fallback">False</property>
  <property name="add_permission">cs.publiccontracts.AddContractsFolder</property>


  <!-- Method aliases -->
  <alias from="(Default)" to="(dynamic view)" />
  <alias from="view" to="(selected layout)" />
  <alias from="edit" to="@@edit" />
  <alias from="sharing" to="@@sharing" />

  <!-- Actions -->
  <action title="View" action_id="view" category="object" condition_expr=""
    url_expr="string:${object_url}/" visible="True">
    <permission value="View" />
  </action>
  <action title="Edit" action_id="edit" category="object" condition_expr=""
    url_expr="string:${object_url}/edit" visible="True">
    <permission value="Modify portal content" />
  </action>
</object>
